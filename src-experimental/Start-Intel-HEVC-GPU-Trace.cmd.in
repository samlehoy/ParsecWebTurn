@echo off
setlocal DisableDelayedExpansion
cd /d "%~dp0"
"%SystemRoot%\System32\fltmc.exe" >nul 2>&1
if errorlevel 1 (
    echo Run this recording helper as administrator. Keep the TEST running normally.
    pause
    exit /b 1
)
if not exist wpr-temp mkdir wpr-temp
"%SystemRoot%\System32\wpr.exe" -start GPU -start "%~dp0..\Intel-HEVC-ETW.wprp!IntelHevc" -filemode -recordtempto "%~dp0wpr-temp" -instancename @TRACE_INSTANCE@ >wpr-start.txt 2>&1
set "start_exit=%ERRORLEVEL%"
type wpr-start.txt
if not "%start_exit%"=="0" (
    echo Recording did not start. Keep wpr-start.txt; do not start the test yet.
    pause
    exit /b 1
)
echo GPU recording started for the synthetic test, PID @PROBE_PID@.
echo NOW press Enter in the ORIGINAL, non-admin test window.
echo When that test finishes, return HERE and press a key to SAVE the trace.
pause
call "%~dp0Stop-Intel-HEVC-GPU-Trace-as-admin.cmd"
pause
