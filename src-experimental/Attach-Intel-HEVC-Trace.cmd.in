@echo off
setlocal
cd /d "%~dp0"
"%SystemRoot%\System32\fltmc.exe" >nul 2>&1
if errorlevel 1 (
    echo Run this ATTACH helper as administrator. Keep the test itself running normally.
    pause
    exit /b 1
)
echo Attaching Microsoft MFTrace to the waiting synthetic test, PID @PROBE_PID@.
echo After attachment, press Enter in the ORIGINAL non-admin test window.
echo When the test finishes, press Ctrl+C here if MFTrace is still waiting.
"%~dp0..\mftrace-tools\mftrace.exe" -v -a @PROBE_PID@ -o intel-hevc-mftrace.txt
pause
