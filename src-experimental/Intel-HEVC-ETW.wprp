<?xml version="1.0" encoding="utf-8"?>
<!-- Diagnostic-only provider selection based on Microsoft's public
     media-foundation/performanceTracing/MF_TRACE.WPRP. Combine with WPR GPU.
     Provider event payloads are diagnostic evidence, not a production API. -->
<WindowsPerformanceRecorder Version="1.0">
  <Profiles>
    <EventCollector Id="HevcCollector" Name="PWT HEVC diagnostic events">
      <BufferSize Value="128"/>
      <Buffers Value="64"/>
    </EventCollector>
    <EventProvider Id="Hevc" Name="3293f985-41d3-4b6a-b187-2ff4aa91f2fc" Level="5">
      <Keywords><Keyword Value="0xffffffffffffffff"/></Keywords>
    </EventProvider>
    <EventProvider Id="HevcTrace" Name="f80bfc2d-11ea-425f-9e7c-d76484d2ec3c" Level="5">
      <Keywords><Keyword Value="0xffffffffffffffff"/></Keywords>
    </EventProvider>
    <EventProvider Id="IntelDecoder" Name="6381f857-7661-4b04-9521-288319e75f12" Level="5">
      <Keywords><Keyword Value="0xffffffffffffffff"/></Keywords>
    </EventProvider>
    <EventProvider Id="MfPlatform" Name="bc97b970-d001-482f-8745-b8d7d5759f99" Level="5">
      <Keywords><Keyword Value="0xffffffffffffffff"/></Keywords>
    </EventProvider>
    <!-- GPU metadata and hardware-scheduled queues supplement the built-in profile.
         State masks combine the standard and HWS masks in Microsoft's profile. -->
    <EventProvider Id="GpuHws" Name="Microsoft-Windows-DxgKrnl" Level="5" NonPagedMemory="true">
      <Keywords><Keyword Value="0x04300277"/></Keywords>
      <CaptureStateOnStart><Keyword Value="0x2490bfff"/></CaptureStateOnStart>
      <CaptureStateOnSave><Keyword Value="0x0490bfff"/></CaptureStateOnSave>
    </EventProvider>
    <Profile Id="IntelHevc.Verbose.File" Name="IntelHevc" Description="HEVC decoder diagnostics and hardware-scheduled GPU queue evidence" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <EventCollectorId Value="HevcCollector">
          <EventProviders>
            <EventProviderId Value="Hevc"/>
            <EventProviderId Value="HevcTrace"/>
            <EventProviderId Value="IntelDecoder"/>
            <EventProviderId Value="MfPlatform"/>
            <EventProviderId Value="GpuHws"/>
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
